<Window x:Class="OD.Planner.Views.TaskExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OD.Planner.Localization"
        Title="{loc:Loc ExportTasks}" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource DefaultFontFamily}">
    <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
        <StackPanel>
            <TextBlock Text="{loc:Loc ExportTasks}" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Text="{loc:Loc ExportDescription}" Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap" Margin="0,12,0,12" />
            <ComboBox Style="{StaticResource ComboBoxBaseStyle}" ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding SelectedMode}" DisplayMemberPath="DisplayName"
                      AutomationProperties.Name="{loc:Loc ExportMode}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:Loc Cancel}" Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="{loc:Loc ExportTasks}" Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True" Click="Export_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
