<Window x:Class="OD.Planner.Views.AlarmPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OD.Planner.Localization"
        Width="340" SizeToContent="Height" MaxHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource DefaultFontFamily}"
        AutomationProperties.Name="{loc:Loc AlarmTitle}">

    <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AlarmGlowBrush}" BorderThickness="1.5">
        <Grid Margin="14,10,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                               Foreground="{DynamicResource OverdueForeground}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc AlarmTitle}" Style="{StaticResource TitleTextStyle}" Margin="8,0,0,0" />
                </StackPanel>
                <Button Style="{StaticResource WindowCloseButtonStyle}" Content="&#xE8BB;"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding StopAllCommand}" />
            </Grid>

            <!-- Items -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,3" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextStyle}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Border Style="{StaticResource PriorityChipStyle}"
                                                Background="{Binding PriorityBackground}">
                                            <TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource ChipTextStyle}"
                                                       Foreground="{Binding PriorityForeground}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LevelText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding LevelBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="{loc:Loc SnoozeOneHour}"
                                            Command="{Binding SnoozeCommand}" Margin="10,0,0,4" />
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="{loc:Loc Stop}"
                                            Command="{Binding StopCommand}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc SnoozeAll}"
                        Command="{Binding SnoozeAllCommand}" />
                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Loc StopAll}"
                        Command="{Binding StopAllCommand}" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
