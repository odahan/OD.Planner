<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Application ===== -->
    <system:String x:Key="AppTitle">OD.Planner</system:String>
    <system:String x:Key="AppVersion">OD.Planner {0} - © 2026 Olivier Dahan</system:String>

    <!-- ===== Main Window ===== -->
    <system:String x:Key="ShowCompleted">Completed</system:String>
    <system:String x:Key="AddTask">Add</system:String>
    <system:String x:Key="FilterByCategory">Filter by category</system:String>
    <system:String x:Key="ShowAllCategories">All</system:String>
    <system:String x:Key="NoTasks">No tasks</system:String>
    <system:String x:Key="AddTaskButton">Add a task</system:String>
    <system:String x:Key="SettingsTooltip">Settings</system:String>
    <system:String x:Key="NewTaskShortcut">New task (Ctrl+N)</system:String>

    <!-- ===== Task Row ===== -->
    <system:String x:Key="AddOneDay">+1d</system:String>
    <system:String x:Key="AddOneWeek">+1w</system:String>
    <system:String x:Key="EditTaskTooltip">Edit (F2)</system:String>
    <system:String x:Key="DeleteTaskTooltip">Delete</system:String>
    <system:String x:Key="MarkCompletedTooltip">Mark as completed</system:String>
    <system:String x:Key="PostponeOneDay">Postpone by one day</system:String>
    <system:String x:Key="PostponeOneWeek">Postpone by one week</system:String>

    <!-- ===== Task Edit Dialog ===== -->
    <system:String x:Key="NewTaskTitle">New Task</system:String>
    <system:String x:Key="EditTaskTitle">Edit Task</system:String>
    <system:String x:Key="TitleLabel">Title</system:String>
    <system:String x:Key="CategoryLabel">Category</system:String>
    <system:String x:Key="PriorityLabel">Priority</system:String>
    <system:String x:Key="DeadlineLabel">Deadline</system:String>
    <system:String x:Key="NoDeadline">No deadline</system:String>
    <system:String x:Key="DaysAfterCreation">X days after creation</system:String>
    <system:String x:Key="FixedDate">Fixed date</system:String>
    <system:String x:Key="DaysPlaceholder">day(s)</system:String>
    <system:String x:Key="NoCategory">No category</system:String>
    <system:String x:Key="PriorityLow">Low</system:String>
    <system:String x:Key="PriorityMedium">Medium</system:String>
    <system:String x:Key="PriorityUrgent">Urgent</system:String>
    <system:String x:Key="PriorityVeryUrgent">Very Urgent</system:String>
    <system:String x:Key="TitleRequired">Title is required.</system:String>
    <system:String x:Key="Cancel">Cancel</system:String>
    <system:String x:Key="Save">Save</system:String>

    <!-- ===== Settings Dialog ===== -->
    <system:String x:Key="SettingsTitle">Settings</system:String>
    <system:String x:Key="Appearance">APPEARANCE</system:String>
    <system:String x:Key="DarkTheme">Dark theme</system:String>
    <system:String x:Key="ShowCompletedTasks">Show completed tasks</system:String>
    <system:String x:Key="ReduceAnimations">Reduce animations (blinking)</system:String>
    <system:String x:Key="SoundAlarms">SOUND ALARMS</system:String>
    <system:String x:Key="EnableSoundAlarms">Enable sound alarms</system:String>
    <system:String x:Key="J1Alert">Alert the day before deadline (D-1)</system:String>
    <system:String x:Key="J0Alert">Alert on the deadline day (D0)</system:String>
    <system:String x:Key="OverdueAlert">Alert when deadline is exceeded</system:String>
    <system:String x:Key="SystemSection">SYSTEM</system:String>
    <system:String x:Key="StartWithWindows">Start with Windows</system:String>
    <system:String x:Key="CategoriesSection">CATEGORIES</system:String>
    <system:String x:Key="NewCategoryPlaceholder">New category, or new name in rename mode</system:String>
    <system:String x:Key="Add">Add</system:String>
    <system:String x:Key="Rename">Rename</system:String>
    <system:String x:Key="Delete">Delete</system:String>
    <system:String x:Key="DatabaseSection">DATABASE</system:String>
    <system:String x:Key="ChangeDbTooltip">Change the database location</system:String>
    <system:String x:Key="DbFileCreated">The tasks.db file will be created in the selected folder.</system:String>
    <system:String x:Key="LanguageSection">LANGUAGE</system:String>
    <system:String x:Key="LanguageEnglish">English</system:String>
    <system:String x:Key="LanguageFrench">French</system:String>
    <system:String x:Key="Close">Close</system:String>
    <system:String x:Key="CategoryExists">A category with this name already exists.</system:String>
    <system:String x:Key="ConfirmDeleteCategory">Delete the category "{0}"?&#x0a;Associated tasks will be moved to "no category".</system:String>
    <system:String x:Key="Browse">Browse…</system:String>
    <system:String x:Key="ChooseDbFolder">Choose the database folder</system:String>

    <!-- ===== Alarm Popup ===== -->
    <system:String x:Key="AlarmTitle">Alarm</system:String>
    <system:String x:Key="SnoozeOneHour">Snooze 1h</system:String>
    <system:String x:Key="Stop">Stop</system:String>
    <system:String x:Key="SnoozeAll">Snooze all (1h)</system:String>
    <system:String x:Key="StopAll">Stop all</system:String>
    <system:String x:Key="AlarmAttention">D-1 — due tomorrow</system:String>
    <system:String x:Key="AlarmDue">D0 — due today</system:String>
    <system:String x:Key="AlarmOverdue">{0}d — overdue</system:String>

    <!-- ===== First Run Dialog ===== -->
    <system:String x:Key="WelcomeTitle">Welcome to OD.Planner</system:String>
    <system:String x:Key="FirstRunDescription">Your tasks will be stored in a SQLite database.</system:String>
    <system:String x:Key="ChooseDbLocation">Choose where to create it (the application folder is suggested by default):</system:String>
    <system:String x:Key="DbPathEmpty">The path is empty.</system:String>
    <system:String x:Key="CannotCreateFolder">Cannot create the folder: {0}</system:String>
    <system:String x:Key="DbExistsWarning">A database already exists at this location. It will be reused.</system:String>
    <system:String x:Key="Quit">Quit</system:String>
    <system:String x:Key="Create">Create</system:String>

    <!-- ===== General ===== -->
    <system:String x:Key="Today">Today</system:String>
    <system:String x:Key="ErrorTitle">Error</system:String>
    <system:String x:Key="ConfirmDeleteTask">Delete the task "{0}"?</system:String>
    <system:String x:Key="DaysSuffix">d</system:String>
    <system:String x:Key="ErrorOccurred">An error occurred:&#x0a;{0}</system:String>

</ResourceDictionary>
