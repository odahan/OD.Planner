<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Application ===== -->
    <system:String x:Key="AppTitle">OD.Planner</system:String>
    <system:String x:Key="AppVersion">OD.Planner {0} - © 2026 Olivier Dahan</system:String>

    <!-- ===== Main Window ===== -->
    <system:String x:Key="CompletedTasks">Terminées</system:String>
    <system:String x:Key="ShowCompletedTasks">Afficher les tâches terminées</system:String>
    <system:String x:Key="AddTask">Ajouter</system:String>
    <system:String x:Key="FilterByCategory">Filtrer par catégorie</system:String>
    <system:String x:Key="ShowAllCategories">Toutes</system:String>
    <system:String x:Key="NoTasks">Aucune tâche</system:String>
    <system:String x:Key="AddTaskButton">Ajouter une tâche</system:String>
    <system:String x:Key="SettingsTooltip">Paramètres</system:String>
    <system:String x:Key="NewTaskShortcut">Nouvelle tâche (Ctrl+N)</system:String>

    <!-- ===== Task Row ===== -->
    <system:String x:Key="AddOneDay">+1j</system:String>
    <system:String x:Key="AddOneWeek">+1sem</system:String>
    <system:String x:Key="EditTaskTooltip">Modifier (F2)</system:String>
    <system:String x:Key="DeleteTaskTooltip">Supprimer</system:String>
    <system:String x:Key="MarkCompletedTooltip">Marquer comme terminée</system:String>
    <system:String x:Key="PostponeOneDay">Repousser d'un jour</system:String>
    <system:String x:Key="PostponeOneWeek">Repousser d'une semaine</system:String>

    <!-- ===== Task Edit Dialog ===== -->
    <system:String x:Key="NewTaskTitle">Nouvelle tâche</system:String>
    <system:String x:Key="EditTaskTitle">Modifier la tâche</system:String>
    <system:String x:Key="TitleLabel">Titre</system:String>
    <system:String x:Key="CategoryLabel">Catégorie</system:String>
    <system:String x:Key="PriorityLabel">Priorité</system:String>
    <system:String x:Key="DeadlineLabel">Échéance</system:String>
    <system:String x:Key="NoDeadline">Aucune échéance</system:String>
    <system:String x:Key="DaysAfterCreation">X jours après la création</system:String>
    <system:String x:Key="FixedDate">Date fixe</system:String>
    <system:String x:Key="DaysPlaceholder">jour(s)</system:String>
    <system:String x:Key="NoCategory">Sans catégorie</system:String>
    <system:String x:Key="PriorityLow">Faible</system:String>
    <system:String x:Key="PriorityMedium">Moyenne</system:String>
    <system:String x:Key="PriorityUrgent">Urgente</system:String>
    <system:String x:Key="PriorityVeryUrgent">Très urgente</system:String>
    <system:String x:Key="TitleRequired">Le titre est obligatoire.</system:String>
    <system:String x:Key="Cancel">Annuler</system:String>
    <system:String x:Key="Save">Enregistrer</system:String>

    <!-- ===== Settings Dialog ===== -->
    <system:String x:Key="SettingsTitle">Paramètres</system:String>
    <system:String x:Key="Appearance">APPARENCE</system:String>
    <system:String x:Key="DarkTheme">Thème sombre</system:String>
    <system:String x:Key="ReduceAnimations">Réduire les animations (clignotement)</system:String>
    <system:String x:Key="SoundAlarms">ALARMES SONORES</system:String>
    <system:String x:Key="EnableSoundAlarms">Activer les alarmes sonores</system:String>
    <system:String x:Key="J1Alert">Alerte la veille de l'échéance (J-1)</system:String>
    <system:String x:Key="J0Alert">Alerte le jour de l'échéance (J0)</system:String>
    <system:String x:Key="OverdueAlert">Alarme quand l'échéance est dépassée</system:String>
    <system:String x:Key="SystemSection">SYSTÈME</system:String>
    <system:String x:Key="StartWithWindows">Démarrer au lancement de Windows</system:String>
    <system:String x:Key="CategoriesSection">CATÉGORIES</system:String>
    <system:String x:Key="NewCategoryPlaceholder">Nouvelle catégorie, ou nouveau nom en mode renommage</system:String>
    <system:String x:Key="Add">Ajouter</system:String>
    <system:String x:Key="Rename">Renommer</system:String>
    <system:String x:Key="Delete">Supprimer</system:String>
    <system:String x:Key="DatabaseSection">BASE DE DONNÉES</system:String>
    <system:String x:Key="ChangeDbTooltip">Changer l'emplacement de la base de données</system:String>
    <system:String x:Key="DbFileCreated">Le fichier tasks.db sera créé dans le dossier choisi.</system:String>
    <system:String x:Key="LanguageSection">LANGUE</system:String>
    <system:String x:Key="LanguageEnglish">Anglais</system:String>
    <system:String x:Key="LanguageFrench">Français</system:String>
    <system:String x:Key="Close">Fermer</system:String>
    <system:String x:Key="CategoryExists">Une catégorie de ce nom existe déjà.</system:String>
    <system:String x:Key="ConfirmDeleteCategory">Supprimer la catégorie « {0} » ?&#x0a;Les tâches associées seront déplacées en « sans catégorie ».</system:String>
    <system:String x:Key="Browse">Parcourir…</system:String>
    <system:String x:Key="ChooseDbFolder">Choisir le dossier de la base de données</system:String>

    <!-- ===== Alarm Popup ===== -->
    <system:String x:Key="AlarmTitle">Alarme</system:String>
    <system:String x:Key="SnoozeOneHour">Snooze 1h</system:String>
    <system:String x:Key="Stop">Arrêter</system:String>
    <system:String x:Key="SnoozeAll">Tout snoozer (1h)</system:String>
    <system:String x:Key="StopAll">Tout arrêter</system:String>
    <system:String x:Key="AlarmAttention">J-1 — échéance demain</system:String>
    <system:String x:Key="AlarmDue">J0 — échéance aujourd'hui</system:String>
    <system:String x:Key="AlarmOverdue">{0}j — échéance dépassée</system:String>

    <!-- ===== First Run Dialog ===== -->
    <system:String x:Key="WelcomeTitle">Bienvenue dans OD.Planner</system:String>
    <system:String x:Key="FirstRunDescription">Vos tâches seront stockées dans une base de données SQLite.</system:String>
    <system:String x:Key="ChooseDbLocation">Choisissez où la créer (le dossier de l'application est proposé par défaut) :</system:String>
    <system:String x:Key="DbPathEmpty">Le chemin est vide.</system:String>
    <system:String x:Key="CannotCreateFolder">Impossible de créer le dossier : {0}</system:String>
    <system:String x:Key="DbExistsWarning">Une base de données existe déjà à cet emplacement. Elle sera réutilisée.</system:String>
    <system:String x:Key="Quit">Quitter</system:String>
    <system:String x:Key="Create">Créer</system:String>

    <!-- ===== General ===== -->
    <system:String x:Key="Today">Aujourd'hui</system:String>
    <system:String x:Key="ErrorTitle">Erreur</system:String>
    <system:String x:Key="ConfirmDeleteTask">Supprimer la tâche « {0} » ?</system:String>
    <system:String x:Key="DaysSuffix">j</system:String>
    <system:String x:Key="ErrorOccurred">Une erreur est survenue :&#x0a;{0}</system:String>
    <system:String x:Key="CategoryOperationFailed">Erreur : {0}</system:String>

</ResourceDictionary>
