<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:OD.Planner.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />

    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    <conv:NullToVisibilityConverter x:Key="NullToVisible" ShowWhenNull="True" />

    <conv:BoolToOpacityConverter x:Key="CompletedOpacity" OnOpacity="1" OffOpacity="0.55" />
    <conv:BoolToOpacityConverter x:Key="BlinkOpacity" OnOpacity="1" OffOpacity="0" />
    <conv:BoolToOpacityConverter x:Key="DisabledOpacity" OnOpacity="1" OffOpacity="0.4" />

    <conv:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToVisible" ShowWhenEmpty="True" />

</ResourceDictionary>
